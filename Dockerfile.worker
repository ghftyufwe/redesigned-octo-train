FROM node:22-slim AS builder
WORKDIR /app
ENV NODE_ENV=development
ENV NPM_CONFIG_UPDATE_NOTIFIER=false
ENV NPM_CONFIG_FUND=false

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl unzip tar \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
ARG SOURCE_REV=railway-worker-hardening-20260819-v2
RUN test "$SOURCE_REV" = "railway-worker-hardening-20260819-v2"
# The worker image does not serve the browser bundle. `npm run build` still
# invokes Vite, so give that build a deliberately non-production browser config.
# The real browser configuration belongs only on the app/Vercel build. Keeping
# placeholders here prevents a worker build from depending on runtime secrets
# or accidentally embedding a customer's Supabase configuration.
ENV VITE_SUPABASE_URL=https://worker-build.invalid \
    VITE_SUPABASE_PUBLISHABLE_KEY=worker-build-placeholder
COPY . ./
# Railway deploys API and worker independently, so each production service
# must remain fail-closed on the exact commit it will run. GitHub Actions is not
# currently a reliable sole gate, and the worker must not deploy a commit whose
# API full-suite gate could later fail. Vitest concurrency is bounded globally
# to avoid PGlite starvation on Railway builders.
RUN npm run typecheck && npm test && npm run build
RUN npm prune --omit=dev --no-audit --no-fund

FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NPM_CONFIG_UPDATE_NOTIFIER=false
ENV NPM_CONFIG_FUND=false
ENV SYFT_PATH=/usr/local/bin/syft

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl unzip tar \
  && rm -rf /var/lib/apt/lists/* \
      && arch="$(dpkg --print-architecture)" \
  && case "$arch" in amd64|arm64) ;; *) echo "Unsupported architecture: $arch" >&2; exit 1 ;; esac \
  && curl -fsSL "https://github.com/anchore/syft/releases/download/v1.49.0/syft_1.49.0_linux_${arch}.tar.gz" -o /tmp/syft.tar.gz \
  && tar -xzf /tmp/syft.tar.gz -C /usr/local/bin syft \
  && chmod 0755 /usr/local/bin/syft \
  && rm -f /tmp/syft.tar.gz \
  && /usr/local/bin/syft version | grep -F '1.49.0'

RUN groupadd --system --gid 10001 spr && useradd --system --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin spr
COPY --from=builder --chown=10001:10001 /app/package.json ./
COPY --from=builder --chown=10001:10001 /app/package-lock.json ./
COPY --from=builder --chown=10001:10001 /app/node_modules ./node_modules
COPY --from=builder --chown=10001:10001 /app/dist ./dist
COPY --from=builder --chown=10001:10001 /app/migrations ./migrations
RUN ! find /app -type f \( -name '.env' -o -name '*.pem' -o -name '*.key' -o -name 'secret*.json' \) -print -quit | grep -q .
USER 10001:10001
CMD ["node", "dist/worker.cjs"]
